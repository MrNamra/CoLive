{
  "name": "colive-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time collaboration extension for VS Code-compatible editors",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "npm run clean --workspaces --if-present && rm -rf dist out coverage .vscode-test",
    "dev:server": "npm run dev -w @colive/server",
    "dev:extension": "npm run watch -w colive",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.17.6",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4"
  }
}
