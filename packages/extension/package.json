{
  "name": "colive",
  "displayName": "CoLive - Real-time Collaboration",
  "description": "Real-time collaborative editing, cursors, comments, and follow mode",
  "version": "0.1.0",
  "type": "module",
  "publisher": "colive-team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/colive/colive.git"
  },
  "bugs": {
    "url": "https://github.com/colive/colive/issues"
  },
  "homepage": "https://github.com/colive/colive#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Collaboration"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "colive",
          "title": "CoLive",
          "icon": "$(broadcast)"
        }
      ]
    },
    "views": {
      "colive": [
        {
          "id": "colive.participants",
          "name": "Participants"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "colive.participants",
        "contents": "Share your workspace or join an active session to collaborate in real-time.\n[Share Workspace](command:colive.startSession)\n[Join Session](command:colive.joinSession)"
      }
    ],
    "commands": [
      {
        "command": "colive.hello",
        "title": "CoLive: Hello",
        "category": "CoLive"
      },
      {
        "command": "colive.startSession",
        "title": "CoLive: Share Workspace",
        "category": "CoLive"
      },
      {
        "command": "colive.joinSession",
        "title": "CoLive: Join Session",
        "category": "CoLive"
      },
      {
        "command": "colive.endSession",
        "title": "CoLive: End / Leave Session",
        "category": "CoLive"
      },
      {
        "command": "colive.copyInvite",
        "title": "CoLive: Copy Invite Link",
        "category": "CoLive"
      },
      {
        "command": "colive.kickParticipant",
        "title": "CoLive: Remove Participant",
        "category": "CoLive"
      },
      {
        "command": "colive.setParticipantPermission",
        "title": "CoLive: Change Permission",
        "category": "CoLive"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "colive.setParticipantPermission",
          "when": "view == colive.participants && viewItem == participant",
          "group": "inline@1"
        },
        {
          "command": "colive.kickParticipant",
          "when": "view == colive.participants && viewItem == participant",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "CoLive",
      "properties": {
        "colive.serverUrl": {
          "type": "string",
          "default": "ws://localhost:8787/ws",
          "description": "WebSocket URL for the CoLive relay server (use wss:// in production)."
        },
        "colive.displayName": {
          "type": "string",
          "default": "",
          "description": "Your display name in collaboration sessions (defaults to Git user or OS username)."
        },
        "colive.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git/**",
            "node_modules/**",
            ".env*",
            "**/*.pem",
            "**/*.key",
            "**/id_rsa*",
            "dist/**",
            "out/**",
            ".vscode/**"
          ],
          "description": "Glob patterns for sensitive or ignored files hidden from collaboration sessions."
        },
        "colive.maxFileSizeMB": {
          "type": "number",
          "default": 5,
          "description": "Maximum file size in MB that can be transferred or opened in a session."
        },
        "colive.defaultGuestPermission": {
          "type": "string",
          "enum": ["readWrite", "readOnly"],
          "default": "readWrite",
          "description": "Default permission granted to new guests."
        },
        "colive.requireJoinApproval": {
          "type": "boolean",
          "default": true,
          "description": "Whether host approval is required for guests to join."
        },
        "colive.allowReadOnlyComments": {
          "type": "boolean",
          "default": true,
          "description": "Allow read-only guests to create and reply to inline comments."
        },
        "colive.userColor": {
          "type": "string",
          "default": "",
          "description": "Custom presence color (hex string)."
        },
        "colive.e2ee": {
          "type": "boolean",
          "default": true,
          "description": "Enable End-to-End Encryption for all session content."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "clean": "rm -rf dist",
    "package": "vsce package --no-dependencies",
    "test": "vitest run"
  },
  "dependencies": {
    "@colive/protocol": "*",
    "fast-diff": "^1.3.0",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@colive/server": "*",
    "@types/node": "^20.17.6",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.13",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
