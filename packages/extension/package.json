{
  "name": "colive",
  "displayName": "CoLive - Real-time Collaboration",
  "description": "Real-time collaborative editing, cursors, comments, and follow mode",
  "version": "0.1.0",
  "type": "module",
  "publisher": "colive-team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrNamra/CoLive.git"
  },
  "bugs": {
    "url": "https://github.com/MrNamra/CoLive/issues"
  },
  "homepage": "https://github.com/MrNamra/CoLive#readme",
  "keywords": [
    "collaboration",
    "live share",
    "pair programming",
    "remote cursor",
    "real-time",
    "yjs",
    "crdt",
    "screen share",
    "code sharing"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Collaboration",
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "colive",
          "title": "CoLive",
          "icon": "$(broadcast)"
        }
      ]
    },
    "views": {
      "colive": [
        {
          "id": "colive.participants",
          "name": "Participants"
        },
        {
          "id": "colive.comments",
          "name": "Comments"
        },
        {
          "type": "webview",
          "id": "colive.chatView",
          "name": "Chat"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "colive.participants",
        "contents": "Share your workspace or join an active session to collaborate in real-time.\n[Share Workspace](command:colive.startSession)\n[Join Session](command:colive.joinSession)"
      }
    ],
    "commands": [
      {
        "command": "colive.hello",
        "title": "CoLive: Hello",
        "category": "CoLive"
      },
      {
        "command": "colive.startSession",
        "title": "CoLive: Share Workspace",
        "category": "CoLive"
      },
      {
        "command": "colive.joinSession",
        "title": "CoLive: Join Session",
        "category": "CoLive"
      },
      {
        "command": "colive.endSession",
        "title": "CoLive: Disconnect / Leave Session",
        "category": "CoLive",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "colive.showLogs",
        "title": "CoLive: Show Output Logs",
        "category": "CoLive",
        "icon": "$(output)"
      },
      {
        "command": "colive.installDependencies",
        "title": "CoLive: Install Dependencies (cloudflared)",
        "category": "CoLive",
        "icon": "$(cloud-download)"
      },
      {
        "command": "colive.copyInvite",
        "title": "CoLive: Copy Invite Link",
        "category": "CoLive"
      },
      {
        "command": "colive.kickParticipant",
        "title": "CoLive: Remove Participant",
        "category": "CoLive"
      },
      {
        "command": "colive.setParticipantPermission",
        "title": "CoLive: Change Permission",
        "category": "CoLive"
      },
      {
        "command": "colive.followParticipant",
        "title": "CoLive: Follow Participant",
        "category": "CoLive"
      },
      {
        "command": "colive.stopFollowing",
        "title": "CoLive: Stop Following",
        "category": "CoLive"
      },
      {
        "command": "colive.exportComments",
        "title": "CoLive: Export Comments",
        "category": "CoLive"
      },
      {
        "command": "colive.importComments",
        "title": "CoLive: Import Comments",
        "category": "CoLive"
      },
      {
        "command": "colive.createComment",
        "title": "Add Comment",
        "category": "CoLive",
        "icon": "$(comment-add)"
      },
      {
        "command": "colive.replyComment",
        "title": "Reply",
        "category": "CoLive",
        "icon": "$(reply)"
      },
      {
        "command": "colive.deleteComment",
        "title": "Delete Comment",
        "category": "CoLive",
        "icon": "$(trash)"
      },
      {
        "command": "colive.resolveCommentThread",
        "title": "Resolve Thread",
        "category": "CoLive",
        "icon": "$(check)"
      },
      {
        "command": "colive.unresolveCommentThread",
        "title": "Reopen Thread",
        "category": "CoLive",
        "icon": "$(refresh)"
      },
      {
        "command": "colive.clearChat",
        "title": "CoLive: Clear Chat History",
        "category": "CoLive",
        "icon": "$(clear-all)"
      },
      {
        "command": "colive.showWalkthrough",
        "title": "CoLive: Show Walkthrough",
        "category": "CoLive"
      },
      {
        "command": "colive.showSessionInfo",
        "title": "CoLive: Show Session Info",
        "category": "CoLive"
      },
      {
        "command": "colive.copyLineLink",
        "title": "CoLive: Copy Link to this Line",
        "category": "CoLive"
      },
      {
        "command": "colive.shareTerminal",
        "title": "CoLive: Share Terminal with Session",
        "category": "CoLive",
        "icon": "$(terminal)"
      },
      {
        "command": "colive.toggleTerminalWrite",
        "title": "CoLive: Toggle Terminal Guest Permissions",
        "category": "CoLive",
        "icon": "$(lock)"
      },
      {
        "command": "colive.setTunnelUrl",
        "title": "CoLive: Set Cloudflare Tunnel URL",
        "category": "CoLive"
      }
    ],
    "keybindings": [
      {
        "command": "colive.startSession",
        "key": "ctrl+alt+l s",
        "mac": "cmd+alt+l s"
      },
      {
        "command": "colive.joinSession",
        "key": "ctrl+alt+l j",
        "mac": "cmd+alt+l j"
      },
      {
        "command": "colive.followParticipant",
        "key": "ctrl+alt+l f",
        "mac": "cmd+alt+l f"
      },
      {
        "command": "colive.shareTerminal",
        "key": "ctrl+alt+l t",
        "mac": "cmd+alt+l t"
      },
      {
        "command": "colive.createComment",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "commentEditorFocused"
      },
      {
        "command": "colive.replyComment",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "commentEditorFocused"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "colive.endSession",
          "when": "view == colive.participants && colive.inSession",
          "group": "navigation@0"
        },
        {
          "command": "colive.showLogs",
          "when": "view == colive.participants",
          "group": "navigation@1"
        },
        {
          "command": "colive.shareTerminal",
          "when": "view == colive.participants && colive.inSession && colive.isHost",
          "group": "navigation@2"
        },
        {
          "command": "colive.toggleTerminalWrite",
          "when": "view == colive.participants && colive.inSession && colive.isHost",
          "group": "navigation@3"
        },
        {
          "command": "colive.clearChat",
          "when": "view == colive.chatView",
          "group": "navigation@0"
        }
      ],
      "editor/context": [
        {
          "command": "colive.copyLineLink",
          "group": "colive@1"
        }
      ],
      "view/item/context": [
        {
          "command": "colive.followParticipant",
          "when": "view == colive.participants && viewItem == participant",
          "group": "navigation@1"
        },
        {
          "command": "colive.setParticipantPermission",
          "when": "view == colive.participants && viewItem == participant",
          "group": "inline@1"
        },
        {
          "command": "colive.kickParticipant",
          "when": "view == colive.participants && viewItem == participant",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "colive.createComment",
          "group": "navigation@1",
          "when": "commentController == colive"
        },
        {
          "command": "colive.replyComment",
          "group": "navigation@2",
          "when": "commentController == colive && commentThread.contextValue == unresolved"
        },
        {
          "command": "colive.resolveCommentThread",
          "group": "navigation@3",
          "when": "commentController == colive && commentThread.contextValue == unresolved"
        },
        {
          "command": "colive.unresolveCommentThread",
          "group": "navigation@3",
          "when": "commentController == colive && commentThread.contextValue == resolved"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "colive.createComment",
          "group": "inline@1",
          "when": "commentController == colive"
        },
        {
          "command": "colive.replyComment",
          "group": "inline@2",
          "when": "commentController == colive"
        }
      ],
      "comments/comment/title": [
        {
          "command": "colive.deleteComment",
          "group": "navigation",
          "when": "commentController == colive && comment.contextValue == canDelete"
        }
      ],
      "comments/comment/context": [
        {
          "command": "colive.deleteComment",
          "group": "1_modification",
          "when": "commentController == colive && comment.contextValue == canDelete"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "colive.welcome",
        "title": "Get Started with CoLive",
        "description": "Learn how to collaborate in real-time with CoLive in VS Code, Cursor, and VSCodium.",
        "steps": [
          {
            "id": "colive.step.displayName",
            "title": "Set Display Name",
            "description": "Customize your visible name and handle.",
            "media": {
              "markdown": "../../docs/walkthrough/1-display-name.md"
            }
          },
          {
            "id": "colive.step.share",
            "title": "Share Workspace",
            "description": "Start a live collaboration session with approval control.",
            "media": {
              "markdown": "../../docs/walkthrough/2-share.md"
            }
          },
          {
            "id": "colive.step.join",
            "title": "Join Session",
            "description": "Connect to an existing shared workspace.",
            "media": {
              "markdown": "../../docs/walkthrough/3-join.md"
            }
          },
          {
            "id": "colive.step.collab",
            "title": "Comments, Follow Mode & Chat",
            "description": "Communicate and co-edit seamlessly.",
            "media": {
              "markdown": "../../docs/walkthrough/4-comments-follow.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "CoLive",
      "properties": {
        "colive.serverUrl": {
          "type": "string",
          "default": "ws://localhost:8787/ws",
          "description": "WebSocket URL for the CoLive relay server (use wss:// in production)."
        },
        "colive.displayName": {
          "type": "string",
          "default": "",
          "description": "Your display name in collaboration sessions (defaults to Git user or OS username)."
        },
        "colive.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git/**",
            "node_modules/**",
            ".env*",
            "**/*.pem",
            "**/*.key",
            "**/id_rsa*",
            "dist/**",
            "out/**",
            ".vscode/**"
          ],
          "description": "Glob patterns for sensitive or ignored files hidden from collaboration sessions."
        },
        "colive.maxFileSizeMB": {
          "type": "number",
          "default": 5,
          "description": "Maximum file size in MB that can be transferred or opened in a session."
        },
        "colive.defaultGuestPermission": {
          "type": "string",
          "enum": ["readWrite", "terminalAccess", "readOnly"],
          "default": "readWrite",
          "description": "Default permission granted to new guests (readWrite, terminalAccess, readOnly)."
        },
        "colive.requireJoinApproval": {
          "type": "boolean",
          "default": true,
          "description": "Whether host approval is required for guests to join."
        },
        "colive.allowReadOnlyComments": {
          "type": "boolean",
          "default": true,
          "description": "Allow read-only guests to create and reply to inline comments."
        },
        "colive.userColor": {
          "type": "string",
          "default": "",
          "description": "Custom presence color (hex string)."
        },
        "colive.e2ee": {
          "type": "boolean",
          "default": true,
          "description": "Enable End-to-End Encryption for all session content."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "clean": "rm -rf dist",
    "package": "vsce package --no-dependencies",
    "test": "vitest run"
  },
  "dependencies": {
    "@colive/protocol": "*",
    "@colive/server": "*",
    "fast-diff": "^1.3.0",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.13",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
